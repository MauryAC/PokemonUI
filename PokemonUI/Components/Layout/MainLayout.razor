@inherits LayoutComponentBase
@rendermode InteractiveServer

@inject AuthState AuthState
@inject NavigationManager Nav

@implements IDisposable

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>

        <!-- ⚡ BARRA SUPERIOR POKÉMON -->
        <div class="top-row px-4 d-flex justify-content-end align-items-center pokemon-navbar">
            @if (AuthState.IsAuthenticated)
            {
                <span class="me-3 user-email">
                    👤 @AuthState.Email
                </span>

                <button class="btn btn-outline"
                        @onclick="Logout">
                    Cerrar sesión
                </button>
            }
            else
            {
                <NavLink class="btn btn-outline" href="/login">
                    🔐 Iniciar sesión
                </NavLink>
            }
        </div>

        <!-- 📄 CONTENIDO -->
        <article class="content px-4 pokemon-card">
            @Body
        </article>

    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    protected override void OnInitialized()
    {
        AuthState.OnChange += OnAuthStateChanged;
    }

    private void OnAuthStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private void Logout()
    {
        AuthState.Logout();
        Nav.NavigateTo("/login", true);
    }

    public void Dispose()
    {
        AuthState.OnChange -= OnAuthStateChanged;
    }
}
