@page "/login"
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject AuthState AuthState


<div class="container d-flex justify-content-center align-items-center"
     style="min-height: 100vh">

    <div class="card shadow-lg p-4" style="width: 100%; max-width: 400px;">
        <h4 class="text-center mb-4 fw-bold">Iniciar sesión</h4>

        <EditForm Model="@loginRequest"
                  OnValidSubmit="HandleLogin"
                  FormName="loginForm">

            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger small" />

            <div class="mb-3">
                <label class="form-label">Correo electrónico</label>
                <InputText class="form-control"
                           placeholder="ejemplo@correo.com"
                           @bind-Value="loginRequest.Email" />
            </div>

            <div class="mb-3">
                <label class="form-label">Contraseña</label>
                <InputText class="form-control"
                           type="password"
                           placeholder="********"
                           @bind-Value="loginRequest.Password" />
            </div>

            <button class="btn btn-primary w-100 mt-2" type="submit">
                Entrar
            </button>
        </EditForm>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger mt-3 text-center">
                @errorMessage
            </div>
        }

        <hr />

        <p class="text-center mb-0">
            ¿No tienes cuenta?
            <a class="fw-semibold" href="/register">
                Regístrate aquí
            </a>
        </p>
    </div>
</div>

@code {
    private LoginRequest loginRequest = new();
    private string? errorMessage;

    private async Task HandleLogin()
    {
        errorMessage = null;

        var result = await AuthService.LoginAsync(loginRequest);

        if (result == null)
        {
            errorMessage = "Correo o contraseña incorrectos";
            return;
        }

        AuthState.Login(
            result.User!.Email!,
            result.Token!
        );



        Navigation.NavigateTo("/");
    }
}
